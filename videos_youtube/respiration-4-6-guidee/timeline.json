 "cues": [
  {
   "debut": 3.0,
   "fin": 3.8306875,
   "texte": "Bonsoir."
  },
  {
   "debut": 5.8306875,
   "fin": 9.895687500000001,
   "texte": "Voici une séance de respiration guidée, pour ralentir avant de dormir."
  },
  {
   "debut": 12.395687500000001,
   "fin": 16.637770833333335,
   "texte": "Écoute-la assis ou allongé, au calme, jamais en conduisant."
  },
  {
   "debut": 18.637770833333335,
   "fin": 22.627750000000002,
   "texte": "Si tu te sens étourdi ou mal à l'aise, arrête et respire normalement."
  },
  {
   "debut": 25.12775,
   "fin": 28.306895833333332,
   "texte": "Si tu ressens une douleur dans la poitrine, appelle le 15."
  },
  {
   "debut": 31.306895833333332,
   "fin": 36.22654166666666,
   "texte": "Le principe est simple : inspirer sur quatre temps, souffler sur six."
  },
  {
   "debut": 39.22654166666666,
   "fin": 43.104812499999994,
   "texte": "Un souffle petit, sans forcer. Tu n'as rien à réussir."
  },
  {
   "debut": 52.104812499999994,
   "fin": 57.02329166666666,
   "texte": "Installe-toi comme tu es bien. Le dos soutenu, les épaules lourdes."
  },
  {
   "debut": 63.023291666666665,
   "fin": 65.379875,
   "texte": "Pose une main sur ton ventre, si tu le souhaites."
  },
  {
   "debut": 71.379875,
   "fin": 75.21470833333333,
   "texte": "Ferme les yeux, ou garde un regard doux sur un point devant toi."
  },
  {
   "debut": 83.21470833333333,
   "fin": 86.68479166666667,
   "texte": "On commence dans un instant. Suis le cercle, et la voix."
  },
  {
