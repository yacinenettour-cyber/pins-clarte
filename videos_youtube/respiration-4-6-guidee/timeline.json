  {
   "debut": 230.72579166666668,
   "fin": 235.01952083333336,
   "texte": "Si ton esprit part ailleurs, ce n'est pas grave. Reviens au souffle."
  },
  {
   "debut": 245.01952083333336,
   "fin": 252.6130416666667,
   "texte": "Maintenant, je me tais. Suis seulement le cercle : il grandit quand tu inspires, il rétrécit quand tu souffles."
  },
  {
   "debut": 379.6130416666667,
   "fin": 382.69758333333334,
   "texte": "Tu respires à ton rythme. Rien d'autre à faire."
  },
  {
   "debut": 515.6975833333333,
   "fin": 519.4029166666667,
   "texte": "Maintenant, laisse ton souffle reprendre son rythme naturel."
  },
  {
   "debut": 527.4029166666667,
   "fin": 530.531125,
   "texte": "Remarque le calme dans ton corps, même s'il est petit."
  },
  {
   "debut": 539.531125,
   "fin": 545.0994166666667,
   "texte": "Si tu es encore réveillé, ce n'est pas grave. Reste au chaud, et laisse la musique jouer."
  },
  {
   "debut": 554.0994166666667,
   "fin": 554.7310625,
   "texte": "Bonne nuit."
